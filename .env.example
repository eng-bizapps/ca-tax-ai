# Copy this file to ".env" and fill in your two values.

# From aistudio.google.com -> Get API key
GEMINI_API_KEY=your-gemini-key-here

# From neon.tech -> your project -> connection string (sales/use tax, CDTFA)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# A SECOND, separate neon.tech project -> connection string (income tax, FTB)
# -- Ring 2 database split, two physically separate databases
INCOME_DATABASE_URL=postgresql://user:password@host2/dbname?sslmode=require

# Defaults (leave as-is unless you know you want to change them)
GEMINI_MODEL=gemini-2.0-flash
EMBED_MODEL=models/gemini-embedding-001
